#!/bin/sh
# Generated by scripts/generate-bootstrap.py; edit scripts/bootstrap.sh.in.
# Platform/download/checksum foundation adapted from Bedouin 0.23.1:
# bedouin install --generate samishal1998/takt@v0.1.0
# Standalone POSIX shell; no Bedouin or Python is required at runtime.
set -eu

takt_version='0.1.0'
takt_temporary=''
takt_original_umask=$(umask)

takt_fail() {
    printf 'takt bootstrap: %s\n' "$*" >&2
    exit 1
}

takt_cleanup() {
    if [ -n "$takt_temporary" ]; then
        rm -rf "$takt_temporary"
        takt_temporary=''
    fi
}

takt_traps() {
    trap 'takt_cleanup' 0
    trap 'takt_cleanup; exit 129' HUP
    trap 'takt_cleanup; exit 130' INT
    trap 'takt_cleanup; exit 143' TERM
}

takt_absolute_path() {
    case "$1" in
        /*) printf '%s\n' "$1" ;;
        *) printf '%s/%s\n' "$(pwd -P)" "$1" ;;
    esac
}

takt_check_destination() {
    [ ! -L "$1" ] || takt_fail "refusing symlink destination: $1"
    [ ! -d "$1" ] || takt_fail "destination is a directory: $1"
}

takt_platform() {
    takt_os=$(uname -s)
    takt_arch=$(uname -m)
    case "$takt_os/$takt_arch" in
        Linux/x86_64)
            takt_target=${TAKT_TARGET:-x86_64-unknown-linux-musl}
            case "$takt_target" in
                x86_64-unknown-linux-musl|x86_64-unknown-linux-gnu) ;;
                *) takt_fail "target $takt_target does not support $takt_os $takt_arch" ;;
            esac
            takt_kernel=$(uname -r)
            takt_major=${takt_kernel%%.*}
            takt_minor=${takt_kernel#*.}
            takt_minor=${takt_minor%%.*}
            takt_minor=${takt_minor%%-*}
            case "$takt_major:$takt_minor" in
                *[!0-9:]*|:*|*:) takt_fail "cannot determine Linux kernel version: $takt_kernel" ;;
            esac
            if [ "$takt_major" -lt 5 ] || { [ "$takt_major" -eq 5 ] && [ "$takt_minor" -lt 15 ]; }; then
                takt_fail "Linux kernel 5.15 or newer is required (found $takt_kernel)"
            fi
            ;;
        Darwin/arm64|Darwin/aarch64)
            takt_target=${TAKT_TARGET:-aarch64-apple-darwin}
            [ "$takt_target" = aarch64-apple-darwin ] || takt_fail "target $takt_target does not support $takt_os $takt_arch"
            takt_macos=$(sw_vers -productVersion)
            takt_major=${takt_macos%%.*}
            case "$takt_major" in
                ''|*[!0-9]*) takt_fail "cannot determine macOS version: $takt_macos" ;;
            esac
            [ "$takt_major" -ge 15 ] || takt_fail "macOS 15 or newer is required (found $takt_macos)"
            ;;
        *) takt_fail "no release for $takt_os $takt_arch; supported: Linux x86_64 and macOS Apple Silicon" ;;
    esac
    case "$takt_target" in
        x86_64-unknown-linux-gnu) takt_expected_sha='8f8bc57908b17b0f78a12dd81ae12dfa3982b5d3b5a8683a66e915a008048bef' ;;
        x86_64-unknown-linux-musl) takt_expected_sha='e474dc067195450ac26903a6f6276bde44e145989a88070ec48e836a353391e8' ;;
        aarch64-apple-darwin) takt_expected_sha='c322913b655699b2ba3c9140590a2ab701fb0f49b6bc94862aa0bddea20e5c77' ;;
    esac
}

takt_cached_binary() {
    takt_platform
    if [ -n "${TAKT_CACHE_DIR:-}" ]; then
        takt_cache_root=$TAKT_CACHE_DIR
    elif [ -n "${XDG_CACHE_HOME:-}" ]; then
        takt_cache_root=$XDG_CACHE_HOME/takt
    else
        [ -n "${HOME:-}" ] || takt_fail 'set HOME or TAKT_CACHE_DIR to choose a cache directory'
        takt_cache_root=$HOME/.cache/takt
    fi
    takt_cache_root=$(takt_absolute_path "$takt_cache_root")
    takt_cache_directory=$takt_cache_root/$takt_version/$takt_target
    takt_binary=$takt_cache_directory/takt
    [ ! -L "$takt_cache_directory" ] || takt_fail "refusing symlink cache directory: $takt_cache_directory"
    takt_check_destination "$takt_binary"
    if [ -f "$takt_binary" ] && [ -x "$takt_binary" ]; then
        return
    fi

    command -v curl >/dev/null 2>&1 || takt_fail 'curl is required for the first download'
    command -v tar >/dev/null 2>&1 || takt_fail 'tar is required for the first download'
    if command -v sha256sum >/dev/null 2>&1; then
        takt_checksum_command=sha256sum
    elif command -v shasum >/dev/null 2>&1; then
        takt_checksum_command=shasum
    else
        takt_fail 'sha256sum or shasum is required to verify the download'
    fi

    umask 077
    mkdir -p "$takt_cache_directory"
    takt_temporary=$(mktemp -d "$takt_cache_directory/.download.XXXXXXXX")
    takt_traps
    takt_archive_name=takt-$takt_version-$takt_target
    takt_url=https://github.com/samishal1998/takt/releases/download/v$takt_version/$takt_archive_name.tar.gz
    printf 'takt bootstrap: downloading %s\n' "$takt_archive_name.tar.gz" >&2
    curl --fail --silent --show-error --location \
        --proto '=https' --proto-redir '=https' \
        --connect-timeout 15 --max-time 180 --retry 2 --retry-delay 1 \
        --output "$takt_temporary/archive.tar.gz" "$takt_url" || takt_fail 'download failed'
    if [ "$takt_checksum_command" = sha256sum ]; then
        takt_actual_sha=$(sha256sum < "$takt_temporary/archive.tar.gz") || takt_fail 'could not compute SHA256'
    else
        takt_actual_sha=$(shasum -a 256 < "$takt_temporary/archive.tar.gz") || takt_fail 'could not compute SHA256'
    fi
    takt_actual_sha=${takt_actual_sha%% *}
    [ "$takt_actual_sha" = "$takt_expected_sha" ] || takt_fail "checksum mismatch for $takt_archive_name.tar.gz"

    # Stream only the expected member to a private file. Never extract archive
    # paths, links, or unrelated members into the filesystem.
    tar -xzOf "$takt_temporary/archive.tar.gz" "$takt_archive_name/takt" > "$takt_temporary/takt" || takt_fail 'cannot extract the release executable'
    [ -s "$takt_temporary/takt" ] || takt_fail 'release executable is empty'
    chmod 755 "$takt_temporary/takt"
    takt_downloaded_version=$("$takt_temporary/takt" --version </dev/null) || takt_fail 'downloaded executable could not run'
    [ "$takt_downloaded_version" = "takt $takt_version" ] || takt_fail "unexpected executable version: $takt_downloaded_version"
    takt_check_destination "$takt_binary"
    mv -f "$takt_temporary/takt" "$takt_binary"
    takt_cleanup
    umask "$takt_original_umask"
}

takt_use_installed() {
    # Inspect every PATH entry, including entries following a wrapper named
    # takt. The probe marker makes copies and symlinks of this wrapper return
    # immediately instead of recursively searching PATH. Probes cannot read
    # the application's stdin, and the final exec preserves arguments/signals.
    takt_search_path=${PATH:-}
    while :; do
        case "$takt_search_path" in
            *:*) takt_path_entry=${takt_search_path%%:*}; takt_search_path=${takt_search_path#*:}; takt_last_entry=0 ;;
            *) takt_path_entry=$takt_search_path; takt_last_entry=1 ;;
        esac
        takt_candidate=${takt_path_entry:-.}/takt
        case "$takt_candidate" in -*) takt_candidate=./$takt_candidate ;; esac
        if [ -f "$takt_candidate" ] && [ -x "$takt_candidate" ]; then
            if takt_installed_version=$(TAKT_BOOTSTRAP_PROBE=1 "$takt_candidate" --version </dev/null 2>/dev/null); then
                case "$takt_installed_version" in
                    'takt '[0-9]*) exec "$takt_candidate" "$@" ;;
                esac
            fi
        fi
        [ "$takt_last_entry" -eq 0 ] || break
    done
}

takt_install() {
    takt_install_directory=${TAKT_INSTALL_DIR:-}
    while [ "$#" -gt 0 ]; do
        case "$1" in
            --bin-dir)
                [ "$#" -ge 2 ] && [ -n "$2" ] || takt_fail '--bin-dir requires a directory'
                takt_install_directory=$2
                shift 2
                ;;
            --help|-h)
                printf '%s\n' \
                    "Install Takt $takt_version (verified release executable)." \
                    'Usage: sh install.sh [--bin-dir DIR]' \
                    'Default: TAKT_INSTALL_DIR, or $HOME/.local/bin.' \
                    'TAKT_CACHE_DIR changes the download cache; TAKT_TARGET selects a compatible target.'
                return
                ;;
            *) takt_fail "unknown installer argument: $1" ;;
        esac
    done
    if [ -z "$takt_install_directory" ]; then
        [ -n "${HOME:-}" ] || takt_fail 'set HOME or TAKT_INSTALL_DIR, or use --bin-dir'
        takt_install_directory=$HOME/.local/bin
    fi
    takt_install_directory=$(takt_absolute_path "$takt_install_directory")
    takt_destination=$takt_install_directory/takt
    takt_check_destination "$takt_destination"
    takt_cached_binary
    if [ "$takt_destination" != "$takt_binary" ]; then
        umask 077
        mkdir -p "$takt_install_directory"
        takt_temporary=$(mktemp -d "$takt_install_directory/.takt-install.XXXXXXXX")
        takt_traps
        cp "$takt_binary" "$takt_temporary/takt"
        chmod 755 "$takt_temporary/takt"
        takt_check_destination "$takt_destination"
        mv -f "$takt_temporary/takt" "$takt_destination"
        takt_cleanup
        umask "$takt_original_umask"
    fi
    printf 'Installed Takt %s to %s\n' "$takt_version" "$takt_destination"
    case ":${PATH:-}:" in
        *":$takt_install_directory:"*) ;;
        *) printf 'Add %s to your PATH to run takt.\n' "$takt_install_directory" >&2 ;;
    esac
}

takt_launch() {
    # A PATH version probe must never recurse into another copy of the launcher.
    [ "${TAKT_BOOTSTRAP_PROBE:-}" != 1 ] || exit 127
    case "${TAKT_USE_SYSTEM:-1}" in
        1) takt_use_installed "$@" ;;
        0) ;;
        *) takt_fail 'TAKT_USE_SYSTEM must be 0 or 1' ;;
    esac
    takt_cached_binary
    exec "$takt_binary" "$@"
}

{
    takt_launch "$@"
}
